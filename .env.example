# ── Khaki Academy — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git.

# ── Supabase ───────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Your Supabase project URL (safe to share, used server-side only here)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service-role secret key — KEEP THIS PRIVATE. Never put in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── API Server ─────────────────────────────────────────────────────────────────
# Port the Express API server listens on (default: 3001)
# API_PORT=3001

# ── Node environment ───────────────────────────────────────────────────────────
# NODE_ENV=development
